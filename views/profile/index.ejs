<div class="container mt-4">
  <div class="row">
    <div class="col-md-4">
      <h2 class="text-white mb-4">My Profile</h2>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      
      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <% if (typeof profile !== 'undefined' && profile) { %>
        <div class="card shadow-sm bg-dark border-secondary text-white">
          <img src="<%= profile.avatar_url || '/images/dummy-avatar.svg' %>" 
               alt="<%= profile.full_name || 'User' %>" 
               class="card-img-top profile-hero" 
               style="height: 250px; object-fit: cover;"
               loading="lazy">
          <div class="card-body text-center">
            <h5 class="card-title" style="color: aliceblue;"><%= profile.full_name %></h5>
            <p class="card-text text-light opacity-75"><%= profile.bio || 'No bio provided' %></p>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-warning">
          <strong>Profile not found.</strong><br>
          Please try logging in again.
        </div>
      <% } %>
    </div>

    <div class="col-md-8">
      <% if (typeof profile !== 'undefined' && profile) { %>
        <ul class="nav nav-tabs border-secondary" id="profileTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active bg-transparent text-white border-secondary" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">Profile Info</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link bg-transparent text-white border-secondary" id="password-tab" data-bs-toggle="tab" data-bs-target="#password" type="button" role="tab">Change Password</button>
          </li>
        </ul>

        <div class="tab-content" id="profileTabContent">
          <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
            <div class="card mt-3 bg-dark border-secondary shadow-sm">
              <div class="card-body">
                <h5 class="card-title mb-4 text-white">Update Profile</h5>
                <form action="/profile/update" method="POST" enctype="multipart/form-data">
                  <div class="mb-3">
                    <label for="full_name" class="form-label text-white">Full Name</label>
                    <input type="text" class="form-control bg-secondary text-white border-0" id="full_name" name="full_name" value="<%= profile.full_name %>" required>
                  </div>

                  <div class="mb-3">
                    <label for="phone" class="form-label text-white">Phone Number</label>
                    <input type="tel" class="form-control bg-secondary text-white border-0" id="phone" name="phone" value="<%= profile.phone %>" required>
                  </div>

                  <div class="mb-3">
                    <label for="bio" class="form-label text-white">Bio</label>
                    <textarea class="form-control bg-secondary text-white border-0" id="bio" name="bio" rows="3"><%= profile.bio || '' %></textarea>
                  </div>

                  <div class="mb-3">
                    <label for="avatar" class="form-label text-white">Profile Photo</label>
                    <input type="file" class="form-control bg-secondary text-white border-0" id="avatar" name="avatar" accept="image/*">
                    <div class="form-text text-light">Leave blank to keep current photo</div>
                  </div>

                  <button type="submit" class="btn btn-primary w-100 mt-2">Save Changes</button>
                </form>
              </div>
            </div>
          </div>

          <div class="tab-pane fade" id="password" role="tabpanel" aria-labelledby="password-tab">
            <div class="card mt-3 bg-dark border-secondary shadow-sm">
              <div class="card-body">
                <h5 class="card-title mb-4 text-white">Change Password</h5>
                <form action="/profile/change-password" method="POST">
                  <div class="mb-3">
                    <label for="new_password" class="form-label text-white">New Password</label>
                    <input type="password" class="form-control bg-secondary text-white border-0" id="new_password" name="new_password" required minlength="8">
                  </div>

                  <div class="mb-3">
                    <label for="confirm_password" class="form-label text-white">Confirm Password</label>
                    <input type="password" class="form-control bg-secondary text-white border-0" id="confirm_password" name="confirm_password" required>
                  </div>

                  <button type="submit" class="btn btn-primary w-100">Update Password</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="text-center mt-5">
           <a href="/login" class="btn btn-primary">Return to Login</a>
        </div>
      <% } %>
    </div>
  </div>
</div>